FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install worker requirements
COPY worker/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Install backend requirements (for shared models/db)
COPY backend/requirements.txt ./backend-requirements.txt
RUN pip install --no-cache-dir -r backend-requirements.txt

# Copy backend code as a package (for shared models, config, db)
COPY backend/app ./backend_app

# Copy worker code
COPY worker/app ./app

ENV PYTHONPATH="/app:${PYTHONPATH}"

CMD ["celery", "-A", "app.worker.app", "worker", "--loglevel=INFO"]
