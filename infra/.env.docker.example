# Environment Variables for Docker Local Development
# Copy this file: cp .env.docker.example .env.docker
# Then update values from `supabase status -o env`

# =============================================================================
# Supabase Local (get values from: supabase status -o env)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY="<paste ANON_KEY from supabase status>"
SUPABASE_SERVICE_ROLE_KEY="<paste SERVICE_ROLE_KEY from supabase status>"

# =============================================================================
# Deepgram (required for transcription)
# =============================================================================
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_API_KEY_IDENTIFIER=your_key_identifier
DEEPGRAM_CONCURRENCY_LIMIT=5
DEEPGRAM_MODEL=nova-3
# Label shown in Deepgram usage reports, so local spend is kept apart.
DEEPGRAM_TAG=local

# For local dev with ngrok tunnel (required for Deepgram in Docker)
# 1. Run: ngrok http 3000
# 2. Set DEEPGRAM_CALLBACK_URL to your ngrok URL + /api/webhooks/deepgram
# 3. Set DEEPGRAM_USE_PROXY=true to route media through the same tunnel
# DEEPGRAM_CALLBACK_URL=https://your-domain.ngrok-free.dev/api/webhooks/deepgram
# start-local.sh sets DEEPGRAM_USE_PROXY=true and generates MEDIA_PROXY_SECRET
# automatically when those variables are missing.
DEEPGRAM_USE_PROXY=true
MEDIA_PROXY_SECRET=

# =============================================================================
# Soniox (optional: the second engine, chosen per transcript)
# =============================================================================
SONIOX_API_KEY=your_soniox_api_key
# A long random string of your own; Soniox sends it back with each callback.
SONIOX_WEBHOOK_SECRET=
SONIOX_MODEL=stt-async-v5
# Callbacks and media reach this machine through the same ngrok tunnel as
# Deepgram's (DEEPGRAM_CALLBACK_URL), so nothing else needs setting.

# =============================================================================
# AssemblyAI (optional: the third engine, chosen per transcript; EU servers)
# =============================================================================
ASSEMBLYAI_API_KEY=your_assemblyai_api_key
# A long random string of your own; AssemblyAI sends it back with each callback.
ASSEMBLYAI_WEBHOOK_SECRET=

# =============================================================================
# App Settings
# =============================================================================
NEXT_PUBLIC_MAX_FILE_SIZE_MB=500
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Enable only for local debugging/demo flows.
NEXT_PUBLIC_RECORDING_DEV_CONTROLS=false

# =============================================================================
# Job and webhook operations
# =============================================================================
TRANSCRIPTION_TIMEOUT_MINUTES=45
RATE_LIMIT_MODE=
WEBHOOK_HEALTHCHECK_SECRET=
