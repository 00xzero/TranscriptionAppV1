# Environment Variables for Docker Local Development
# Copy this file: cp .env.docker.example .env.docker
# Then update values from `supabase status -o env`

# =============================================================================
# Supabase Local (get values from: supabase status -o env)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste ANON_KEY from supabase status>
SUPABASE_SERVICE_ROLE_KEY=<paste SERVICE_ROLE_KEY from supabase status>

# =============================================================================
# Deepgram (required for transcription)
# =============================================================================
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_API_KEY_IDENTIFIER=your_key_identifier
DEEPGRAM_CONCURRENCY_LIMIT=5
DEEPGRAM_MODEL=nova-3

# For local dev with ngrok tunnel (required for Deepgram in Docker)
# 1. Run: ngrok http 3000
# 2. Set DEEPGRAM_CALLBACK_URL to your ngrok URL + /api/webhooks/deepgram
# 3. Set DEEPGRAM_USE_PROXY=true to route media through the same tunnel
# DEEPGRAM_CALLBACK_URL=https://your-domain.ngrok-free.dev/api/webhooks/deepgram
# DEEPGRAM_USE_PROXY=true
# MEDIA_PROXY_SECRET=your-secret-here

# =============================================================================
# App Settings
# =============================================================================
NEXT_PUBLIC_MAX_FILE_SIZE_MB=50
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Legacy (can be removed after Phase 11)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TOKEN=devtoken
