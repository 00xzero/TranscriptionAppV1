# Rename to .env for local development
ENV=dev
SECRET_KEY=dev
SINGLE_USER_TOKEN=devtoken

# Database & Cache
DATABASE_URL=postgresql://app:app@postgres:5432/meeting
REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO)
S3_ENDPOINT_URL=http://minio:9000
# Public URL for the browser to reach MinIO (used to rewrite presigned URLs)
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=media

DEEPGRAM_API_KEY=changeme
DEEPGRAM_MODEL=nova-3

# Supabase cookie name override (optional)
# NEXT_PUBLIC_SUPABASE_COOKIE_NAME=sb-<project-ref>-auth-token
