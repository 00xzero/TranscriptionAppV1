# Supabase Configuration
# For local Supabase, use the values printed by `supabase status -o env`.
# For a hosted project, get them from Supabase Dashboard -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Storage Configuration
# Maximum file upload size in MB
# Matches the media bucket's limit (500 MB). The Supabase project's global
# upload limit (Storage Settings) must be at least this.
NEXT_PUBLIC_MAX_FILE_SIZE_MB=500

# Recording developer controls
# Enable only for local debugging/demo flows.
NEXT_PUBLIC_RECORDING_DEV_CONTROLS=false

# Application URL used when constructing callback URLs locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inngest Configuration
# For local dev: leave keys empty and enable dev mode so the SDK talks to the
# local Inngest Dev Server instead of defaulting to cloud mode in v4.
# Local dev server: http://localhost:8288
# For production: get from Inngest Dashboard → Manage → API Keys
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Deepgram Configuration
# API key for transcription.
DEEPGRAM_API_KEY=
# Our own secret, hex only (openssl rand -hex 32). The callback URL carries it
# as deepgram:<secret>@, Deepgram sends it back as Basic Auth on every callback,
# and the webhook refuses callbacks without it. A deployment needs it set
# before it goes live.
DEEPGRAM_WEBHOOK_SECRET=
# Public callback URL. Set this when using ngrok or another public tunnel.
# DEEPGRAM_CALLBACK_URL=https://your-domain.ngrok-free.dev/api/webhooks/deepgram
# Set true to route Deepgram media through /api/media-proxy.
DEEPGRAM_USE_PROXY=false
# Required when DEEPGRAM_USE_PROXY=true.
MEDIA_PROXY_SECRET=
# Concurrency limit for Deepgram API calls (default: 5)
DEEPGRAM_CONCURRENCY_LIMIT=5
DEEPGRAM_MODEL=nova-3
# Label shown in Deepgram usage reports, to tell environments apart (e.g. hosted).
DEEPGRAM_TAG=

# Soniox Configuration (the second engine, chosen per transcript)
# API key from the Soniox Console.
SONIOX_API_KEY=
# A long random string of your own. Soniox sends it back with each callback
# ("Authorization: Bearer <secret>"); the webhook refuses callbacks without it.
SONIOX_WEBHOOK_SECRET=
# Callbacks and the media proxy use the same public address as Deepgram's
# (DEEPGRAM_CALLBACK_URL's origin, else NEXT_PUBLIC_APP_URL).
SONIOX_MODEL=stt-async-v5

# AssemblyAI Configuration (the third engine, chosen per transcript)
# API key from the AssemblyAI dashboard.
ASSEMBLYAI_API_KEY=
# A long random string of your own. AssemblyAI sends it back with each callback
# ("Authorization: Bearer <secret>"); the webhook refuses callbacks without it.
ASSEMBLYAI_WEBHOOK_SECRET=
# EU servers by default; callbacks use the same public address as Deepgram's.
# ASSEMBLYAI_API_URL=https://api.eu.assemblyai.com

# Job and webhook operations
TRANSCRIPTION_TIMEOUT_MINUTES=45
RATE_LIMIT_MODE=
WEBHOOK_HEALTHCHECK_SECRET=

# Operational smoke tests
TEST_EMAIL=
TEST_PASSWORD=
